# ---------------------------------------------------------------
# C-03 Filtro inteligente de reseñas (avisos al gerente)
# Sin estas variables todo funciona en "modo simulado": el aviso queda
# registrado con un botón para enviarlo a mano por WhatsApp/correo.
# ---------------------------------------------------------------
# WhatsApp Business Platform (Cloud API de Meta)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Opcional: plantilla aprobada (necesaria para escribir fuera de la ventana de 24 h)
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="es"

# Correo vía Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="ZELO Review <alertas@tudominio.com>"

# n8n: recibe cada evento (review.intercepted, review.recovered…) en JSON
N8N_WEBHOOK_URL=""

# Cron de recordatorio único (24 h) y seguimiento (2 días)
# curl "https://TU_DOMINIO/api/cron/follow-ups?key=$CRON_SECRET"
CRON_SECRET="cambia-esto"
REMINDER_AFTER_MINUTES="1440"
FOLLOWUP_AFTER_MINUTES="2880"
APP_TIMEZONE="America/Lima"
