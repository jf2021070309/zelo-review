datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  BUSINESS_OWNER
}

enum DeviceStatus {
  IN_PRODUCTION
  READY_TO_ASSIGN
  ACTIVE
  SUSPENDED
}

enum DeviceMode {
  DIRECT_REDIRECT
  SMART_PROFILE
}

enum ScanSource {
  QR
  NFC
  DIRECT
  UNKNOWN
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  name         String
  role         Role       @default(BUSINESS_OWNER)
  businesses   Business[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}

model Business {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  slug            String    @unique
  logoUrl         String?
  coverUrl        String?
  googleReviewUrl String?
  phone           String?
  whatsapp        String?
  instagram       String?
  website         String?
  address         String?
  category        String?
  devices         Device[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("businesses")
}

model Batch {
  id        String   @id @default(uuid())
  name      String
  quantity  Int
  prefix    String   @default("ZL")
  notes     String?
  devices   Device[]
  createdAt DateTime @default(now())

  @@map("batches")
}

model Device {
  id                  String        @id @default(uuid())
  code                String        @unique // ej: ZL-8F29KD
  activationPin       String        // Código de 4 a 6 dígitos para registrar la placa
  status              DeviceStatus  @default(READY_TO_ASSIGN)
  mode                DeviceMode    @default(DIRECT_REDIRECT)
  customDestinationUrl String?
  
  businessId          String?
  business            Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  
  batchId             String?
  batch               Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)

  smartProfile        SmartProfile?
  scanEvents          ScanEvent[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("devices")
}

model SmartProfile {
  id                  String       @id @default(uuid())
  deviceId            String       @unique
  device              Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  title               String?
  description         String?
  theme               String       @default("dark_gold") // dark_gold, neon_indigo, emerald_luxury, clean_white, ruby_elegance
  
  googleReviewUrl     String?
  googleReviewEnabled Boolean      @default(true)
  
  whatsappNumber      String?
  whatsappMessage     String?      @default("Hola! Vengo desde la placa Zelo.")
  whatsappEnabled     Boolean      @default(false)
  
  instagramHandle     String?
  instagramEnabled    Boolean      @default(false)
  
  websiteUrl          String?
  websiteEnabled      Boolean      @default(false)
  
  menuUrl             String?
  menuEnabled         Boolean      @default(false)
  
  wifiSsid            String?
  wifiPassword        String?
  wifiEnabled         Boolean      @default(false)
  
  googleMapsUrl       String?
  googleMapsEnabled   Boolean      @default(false)
  
  customLinks         SmartLink[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("smart_profiles")
}

model SmartLink {
  id             String       @id @default(uuid())
  profileId      String
  profile        SmartProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String
  url            String
  icon           String       @default("globe") // star, globe, gift, shopping-bag, facebook, tiktok, tripadvisor, mail, phone
  order          Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("smart_links")
}

model ScanEvent {
  id         String     @id @default(uuid())
  deviceId   String
  device     Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  source     ScanSource @default(UNKNOWN) // QR, NFC, DIRECT
  ipHash     String?
  userAgent  String?
  deviceType String?    // mobile, tablet, desktop
  os         String?    // iOS, Android, Windows, macOS, Linux
  browser    String?    // Safari, Chrome, Firefox, Edge
  city       String?
  country    String?
  createdAt  DateTime   @default(now())

  @@index([deviceId, createdAt])
  @@index([source])
  @@map("scan_events")
}
